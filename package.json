{
  "name": "game-todo",
  "version": "0.3.0",
  "description": "Event and quest ToDo for Genshin Impact and Wuthering Waves in Obsidian, with prerequisite-aware scheduling.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "todo",
    "genshin",
    "wuthering-waves"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
